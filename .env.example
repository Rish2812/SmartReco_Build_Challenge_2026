# --- Mesh API (required for all LLM calls) ---
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=openai/gpt-4o-mini

# --- Auth ---
JWT_SECRET=change_this_to_a_random_secret
JWT_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite:///./smartreco.db

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Recommendation trigger tuning ---
REC_EVENT_THRESHOLD=5
REC_MIN_REFRESH_SECONDS=120

# --- Bonus: scheduled digest email (optional, leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=noreply@smartreco.local
DIGEST_SEND_HOUR=15
DIGEST_SEND_MINUTE=0
